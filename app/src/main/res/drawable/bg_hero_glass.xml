<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#D9101B25" android:centerColor="#B80A1620" android:endColor="#C00B111A" />
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
        </shape>
    </item>
    <item android:gravity="right|top" android:width="190dp" android:height="190dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="170dp" android:centerColor="#440091B3" android:endColor="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
