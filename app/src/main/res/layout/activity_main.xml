<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Base legendary-tech HUD backdrop, always present -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_legendary" />

    <!-- Default cinematic supercar backdrop. A user-selected image can replace
         it from Signal, while the same opacity control remains available. -->
    <ImageView
        android:id="@+id/bg_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_supercar_default"
        android:alpha="0.62"
        android:contentDescription="@null" />

    <!-- Cinematic scrim/vignette: keeps the photo rich without sacrificing
         readability of the player controls and glass UI. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_photo_scrim"
        android:clickable="false"
        android:focusable="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- One persistent RVH Music shell. Content changes contextually inside
             the same visual environment; there is no special "home" identity. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="14dp"
            android:paddingBottom="8dp">

            <ImageButton
                android:id="@+id/btn_header_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_nav_back"
                android:visibility="gone"
                android:contentDescription="Back"
                app:tint="@color/text_on_photo_secondary" />

            <ImageView
                android:id="@+id/header_avatar"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_header_avatar"
                android:padding="6dp"
                android:src="@mipmap/ic_launcher"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/header_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:gravity="center"
                android:text="RVH MUSIC"
                android:textColor="@color/text_on_photo_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.16" />

            <ImageButton
                android:id="@+id/btn_header_search"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_nav_search"
                app:tint="@color/text_on_photo_secondary"
                android:contentDescription="Search library" />

            <ImageButton
                android:id="@+id/btn_header_more"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_more"
                app:tint="@color/text_on_photo_secondary"
                android:contentDescription="More music controls" />
        </LinearLayout>

        <com.henrylumis.mediaprayer.ui.SwipeDismissFrameLayout
            android:id="@+id/main_fragment_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <include
            android:id="@+id/mini_player"
            layout="@layout/view_mini_player"
            android:layout_width="match_parent"
            android:layout_height="68dp" />

    </LinearLayout>

</FrameLayout>
