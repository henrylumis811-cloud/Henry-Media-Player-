<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" android:layout_marginVertical="4dp"
    android:padding="10dp" android:gravity="center_vertical" android:background="@android:color/transparent" android:clickable="true" android:focusable="true" android:orientation="horizontal" android:foreground="?attr/selectableItemBackground">
    <ImageView android:id="@+id/artwork" android:layout_width="56dp" android:layout_height="56dp" android:scaleType="centerCrop" android:background="@drawable/bg_card" android:contentDescription="Playlist artwork" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
        <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_on_photo_primary" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/count" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/text_on_photo_secondary" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
