<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:clickable="true"
    android:focusable="true"
    android:contentDescription="Open full lyrics"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <TextView
        android:id="@+id/live_lyrics_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:maxLines="1"
        android:singleLine="true"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeMaxTextSize="22sp"
        android:autoSizeStepGranularity="1sp"
        android:text=""
        android:textColor="@color/text_on_photo_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:letterSpacing="0.01"
        android:shadowColor="#66000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="8"
        android:contentDescription="Current lyric" />

    <!-- Kept hidden so the existing lyrics engine can calculate the active line. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/live_lyrics_list"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/live_lyrics_mode"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/live_lyrics_empty"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
</FrameLayout>
